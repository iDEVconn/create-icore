# Transport (gateway ↔ this MS)
AI_TRANSPORT=tcp
AI_HOST=127.0.0.1
AI_PORT=4005
# AI_REDIS_URL=redis://localhost:6379
# AI_NATS_URL=nats://localhost:4222
# AI_MQTT_URL=mqtt://localhost:1883
# AI_RMQ_URL=amqp://localhost:5672
# AI_RMQ_QUEUE=ai_queue
# AI_KAFKA_BROKERS=localhost:9092
# AI_KAFKA_CLIENT_ID=ai

# Platform-default LLM provider. BYOK (per-call apiKey) works regardless of
# whether a platform key below is set — see LlmRegistry's BYOK-only mode.
AI_PROVIDER=gemini

# --- Platform API keys (all optional — omit any provider you don't fund) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Cost enforcement (optional — both AI_PRICING_JSON and at least one cap
#     are required together, otherwise budget checks are skipped) ---
# AI_PRICING_JSON={"gemini":{"gemini-2.5-flash-lite":{"inputPer1M":0,"outputPer1M":0}}}
# AI_MAX_COST_PER_CALL=0.50
# AI_MAX_COST_TOTAL=50

# --- RAG (optional — needs its own Postgres+pgvector instance, independent
#     of DB_PROVIDER; leave both blank to disable rag.query) ---
# AI_RAG_POSTGRES_URL=postgresql://user:pass@localhost:5432/icore
