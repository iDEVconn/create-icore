{
  "name": "ai-orchestrator-e2e",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["ai-orchestrator"],
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "dependsOn": ["ai-orchestrator:build", "ai-orchestrator:serve"],
      "options": {
        "jestConfig": "apps/microservices/ai-orchestrator-e2e/jest.config.cts",
        "passWithNoTests": true
      }
    }
  }
}
