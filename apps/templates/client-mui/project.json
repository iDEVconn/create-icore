{
  "name": "client-mui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/templates/client-mui/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project client-mui --web",
  "targets": {
    "graphql-codegen": {
      "executor": "nx:run-commands",
      "dependsOn": ["api:graphql-schema"],
      "inputs": [
        "{projectRoot}/codegen.ts",
        "{projectRoot}/src/graphql/gql/*.graphql",
        "{workspaceRoot}/apps/api/schema.gql"
      ],
      "outputs": ["{projectRoot}/src/gql/types.ts"],
      "options": {
        "command": "graphql-codegen --config codegen.ts",
        "cwd": "apps/templates/client-mui"
      }
    }
  }
}
