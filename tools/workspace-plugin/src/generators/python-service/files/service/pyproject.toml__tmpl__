[project]
name = "<%= fileName %>"
version = "0.1.0"
description = "<%= className %> Python microservice (<%= framework %>)"
readme = "README.md"
requires-python = ">=3.12"
dependencies = [
<% if (framework === 'fastapi') { -%>
  "fastapi>=0.115.0",
  "uvicorn[standard]>=0.32.0",
  "pydantic>=2.10.0",
  "pydantic-settings>=2.6.0",
<% } else { -%>
  "grpcio>=1.68.0",
  "grpcio-tools>=1.68.0",
  "protobuf>=5.28.0",
  "pydantic>=2.10.0",
<% } -%>
]

[dependency-groups]
dev = [
<% if (framework === 'fastapi') { -%>
  "httpx>=0.28.0",
<% } -%>
  "mypy>=1.13.0",
  "pytest>=8.3.0",
  "pytest-asyncio>=0.24.0",
  "ruff>=0.8.0",
]

[tool.ruff]
line-length = 100
target-version = "py312"
extend-exclude = ["src/generated"]

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B"]

[tool.pytest.ini_options]
pythonpath = [".", "src/generated"]
testpaths = ["tests"]
asyncio_mode = "auto"

[tool.mypy]
python_version = "3.12"
strict = true
exclude = ["src/generated"]
