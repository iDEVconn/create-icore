{
  "name": "<%= fileName %>",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/microservices/<%= fileName %>/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/microservices/<%= fileName %>"],
      "options": {
        "command": "webpack-cli build",
        "env": { "NODE_ENV": "production" },
        "cwd": "apps/microservices/<%= fileName %>"
      },
      "configurations": {
        "development": {
          "env": { "NODE_ENV": "development" }
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/microservices/<%= fileName %>/package.json",
        "{workspaceRoot}/dist/apps/microservices/<%= fileName %>/yarn.lock"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/microservices/<%= fileName %>/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "<%= fileName %>:build",
        "runBuildTargetDependencies": false,
        "port": <%= inspectPort %>
      },
      "configurations": {
        "development": {
          "buildTarget": "<%= fileName %>:build:development"
        },
        "production": {
          "buildTarget": "<%= fileName %>:build:production"
        }
      }
    }
  },
  "tags": <%- msTagsJson %>
}
