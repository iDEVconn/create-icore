import { DynamicModule, Module } from '@nestjs/common';
import { ClientsModule } from '@nestjs/microservices';
import { buildTransport } from '@icore/shared';
import { <%= className %>ClientService } from './<%= fileName %>-client.service';
import { <%= constantName %>_CLIENT } from './<%= fileName %>-client.tokens';

@Module({})
export class <%= className %>ClientModule {
  static forRoot(): DynamicModule {
    return {
      module: <%= className %>ClientModule,
      imports: [
        ClientsModule.registerAsync([
          {
            name: <%= constantName %>_CLIENT,
            useFactory: () => buildTransport('<%= constantName %>'),
          },
        ]),
      ],
      providers: [<%= className %>ClientService],
      exports: [<%= className %>ClientService],
    };
  }
}
