{
  "name": "icore-app",
  "version": "0.0.1",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "apps/*",
    "apps/microservices/*",
    "apps/templates/*",
    "libs/*",
    "libs/auth-strategies/*",
    "libs/storage-strategies/*",
    "libs/db-strategies/*"
  ],
  "scripts": {
    "dev": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run-many -t serve",
    "build": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run-many -t build",
    "lint": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run-many -t lint",
    "test": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run-many -t test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "remove-notes": "node tools/remove-notes.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@icore/vite-plugins": "*",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@nx/devkit": "24.0.4",
    "@nx/eslint": "24.0.4",
    "@nx/eslint-plugin": "24.0.4",
    "@nx/jest": "24.0.4",
    "@nx/js": "24.0.4",
    "@nx/nest": "24.0.4",
    "@nx/node": "24.0.4",
    "@nx/playwright": "24.0.4",
    "@nx/react": "24.0.4",
    "@nx/vite": "24.0.4",
    "@nx/vitest": "24.0.4",
    "@nx/web": "24.0.4",
    "@nx/webpack": "24.0.4",
    "@playwright/test": "^1.65.0",
    "@swc-node/register": "~1.12.1",
    "@swc/cli": "~0.8.2",
    "@swc/core": "~1.16.22",
    "@swc/helpers": "~0.5.24",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "~30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "~5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-environment-node": "~30.5.2",
    "jest-util": "~30.5.1",
    "jiti": "2.7.0",
    "jsdom": "~30.1.3",
    "jsonc-eslint-parser": "^3.3.0",
    "lint-staged": "^17.6.0",
    "nx": "24.0.4",
    "prettier": "~3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "10.9.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "~5.1.0",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1"
  },
  "lint-staged": {
    "*.{json,md}": [
      "prettier --write"
    ],
    "*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --cache --fix"
    ]
  },
  "dependencies": {
    "@casl/ability": "^7.1.1",
    "@casl/react": "^7.1.0",
    "@idevconn/api-client": "^0.3.3",
    "@idevconn/use-draft": "^0.2.3",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/microservices": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.7.1",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router": "^1.170.46",
    "axios": "^1.21.0",
    "better-sqlite3": "^13.0.3",
    "classnames": "^2.5.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.23",
    "i18next": "^26.7.2",
    "react-i18next": "^17.1.13",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zustand": "^5.0.16"
  }
}
