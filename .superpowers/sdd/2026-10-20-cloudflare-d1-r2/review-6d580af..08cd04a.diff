+++ b/libs/db-strategies/d1/src/lib/__tests__/d1-rest-client.unit.test.ts
@@ -0,0 +1,109 @@
+import { createD1RestClient, D1ApiError } from '../d1-client';
+
+const URL_ = 'https://api.cloudflare.com/client/v4/accounts/acc/d1/database/db/query';
+
+const ok = (results: unknown[], changes = 0) =>
+  new Response(
+    JSON.stringify({ success: true, errors: [], result: [{ results, meta: { changes } }] }),
+    {
+      status: 200,
+    },
+  );
+
+const fail = (status: number, codes: number[], headers: Record<string, string> = {}) =>
+  new Response(
+    JSON.stringify({
+      success: false,
+      errors: codes.map((code) => ({ code, message: 'x' })),
+      result: [],
+    }),
+    { status, headers },
+  );
+
+const make = (fetchFn: typeof fetch, extra: Record<string, unknown> = {}) => {
+  const sleep = vi.fn().mockResolvedValue(undefined);
+  const client = createD1RestClient({
+    accountId: 'acc',
+    databaseId: 'db',
+    apiToken: 'tok',
+    fetch: fetchFn,
+    sleep,
+    ...extra,
+  });
+  return { client, sleep };
+};
+
+describe('createD1RestClient', () => {
+  it('posts sql and params to the account/database query URL with a Bearer token', async () => {
+    const fetchFn = vi.fn().mockResolvedValue(ok([]));
+    const { client } = make(fetchFn);
+    await client.query('SELECT ?', ['a']);
+    const [url, init] = fetchFn.mock.calls[0];
+    expect(url).toBe(URL_);
+    expect(init.method).toBe('POST');
+    expect(init.headers.Authorization).toBe('Bearer tok');
+    expect(JSON.parse(init.body)).toEqual({ sql: 'SELECT ?', params: ['a'] });
+  });
+
+  it('returns rows and changes from result[0].results and result[0].meta.changes', async () => {
+    const { client } = make(vi.fn().mockResolvedValue(ok([{ id: '1' }], 3)));
+    expect(await client.query('x')).toEqual({ rows: [{ id: '1' }], changes: 3 });
+  });
+
+  it('throws D1ApiError with status and Cloudflare error codes on success:false', async () => {
+    const { client } = make(vi.fn().mockResolvedValue(fail(400, [7500, 7501])));
+    const err = await client.query('x').catch((e) => e);
+    expect(err).toBeInstanceOf(D1ApiError);
+    expect(err.status).toBe(400);
+    expect(err.codes).toEqual([7500, 7501]);
+  });
+
+  it.each([400, 401, 403, 500])('does not retry a %i', async (status) => {
+    const fetchFn = vi.fn().mockResolvedValue(fail(status, [1]));
+    const { client, sleep } = make(fetchFn);
+    await expect(client.query('x')).rejects.toBeInstanceOf(D1ApiError);
+    expect(fetchFn).toHaveBeenCalledTimes(1);
+    expect(sleep).not.toHaveBeenCalled();
+  });
+
+  it('retries 429 then succeeds, honouring Retry-After', async () => {
+    const fetchFn = vi
+      .fn()
+      .mockResolvedValueOnce(fail(429, [971], { 'Retry-After': '1' }))
+      .mockResolvedValueOnce(ok([{ a: 1 }]));
+    const { client, sleep } = make(fetchFn);
+    expect((await client.query('x')).rows).toEqual([{ a: 1 }]);
+    expect(fetchFn).toHaveBeenCalledTimes(2);
+    expect(sleep).toHaveBeenCalledWith(1000);
+  });
+
+  it('gives up after maxRetries and throws D1ApiError', async () => {
+    const fetchFn = vi.fn().mockImplementation(async () => fail(503, [1]));
+    const { client } = make(fetchFn);
+    const err = await client.query('x').catch((e) => e);
+    expect(err).toBeInstanceOf(D1ApiError);
+    expect(err.status).toBe(503);
+    expect(fetchFn).toHaveBeenCalledTimes(3);
+  });
+
+  it('retries a pre-response network error then succeeds', async () => {
+    const fetchFn = vi
+      .fn()
+      .mockRejectedValueOnce(new TypeError('fetch failed'))
+      .mockResolvedValueOnce(ok([]));
+    const { client } = make(fetchFn);
+    await expect(client.query('x')).resolves.toEqual({ rows: [], changes: 0 });
+    expect(fetchFn).toHaveBeenCalledTimes(2);
+  });
+
+  it('aborts and throws when the request exceeds timeoutMs', async () => {
+    const fetchFn = vi.fn(
+      (_u: unknown, init: RequestInit) =>
+        new Promise<Response>((_res, rej) => {
+          init.signal?.addEventListener('abort', () => rej(init.signal?.reason));
+        }),
+    ) as unknown as typeof fetch;
+    const { client } = make(fetchFn, { timeoutMs: 20, maxRetries: 0 });
+    await expect(client.query('x')).rejects.toBeDefined();
+  });
+});
diff --git a/libs/db-strategies/d1/src/lib/d1-client.ts b/libs/db-strategies/d1/src/lib/d1-client.ts
new file mode 100644
index 0000000..97f80ed
--- /dev/null
+++ b/libs/db-strategies/d1/src/lib/d1-client.ts
@@ -0,0 +1,110 @@
+export type D1Param = string | number | null;
+
+export interface D1QueryResult<T> {
+  rows: T[];
+  changes: number;
+}
+
+export interface D1ClientLike {
+  query<T = Record<string, unknown>>(sql: string, params?: D1Param[]): Promise<D1QueryResult<T>>;
+}
+
+export class D1ApiError extends Error {
+  constructor(
+    message: string,
+    public readonly status: number,
+    public readonly codes: number[] = [],
+  ) {
+    super(message);
+    this.name = 'D1ApiError';
+  }
+}
+
+export interface D1RestClientOptions {
+  accountId: string;
+  databaseId: string;
+  apiToken: string;
+  fetch?: typeof fetch;
+  timeoutMs?: number;
+  maxRetries?: number;
+  sleep?: (ms: number) => Promise<void>;
+}
+
+interface D1Envelope {
+  success?: boolean;
+  errors?: { code: number; message: string }[];
+  result?: { results?: unknown[]; meta?: { changes?: number } }[];
+}
+
+const RETRYABLE_STATUS = new Set([429, 503]);
+const BASE_BACKOFF_MS = 250;
+
+const defaultSleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));
+
+function isTimeout(err: unknown): boolean {
+  return err instanceof Error && (err.name === 'TimeoutError' || err.name === 'AbortError');
+}
+
+function backoffMs(attempt: number, retryAfter: string | null): number {
+  const seconds = retryAfter === null ? NaN : Number(retryAfter);
+  if (Number.isFinite(seconds) && seconds >= 0) return seconds * 1000;
+  return BASE_BACKOFF_MS * 2 ** attempt;
+}
+
+export function createD1RestClient(opts: D1RestClientOptions): D1ClientLike {
+  const doFetch = opts.fetch ?? fetch;
+  const timeoutMs = opts.timeoutMs ?? 10_000;
+  const maxRetries = opts.maxRetries ?? 2;
+  const sleep = opts.sleep ?? defaultSleep;
+  const url = `https://api.cloudflare.com/client/v4/accounts/${opts.accountId}/d1/database/${opts.databaseId}/query`;
+
+  return {
+    async query<T = Record<string, unknown>>(
+      sql: string,
+      params: D1Param[] = [],
+    ): Promise<D1QueryResult<T>> {
+      for (let attempt = 0; ; attempt++) {
+        let res: Response;
+        try {
+          res = await doFetch(url, {
+            method: 'POST',
+            headers: {
+              Authorization: `Bearer ${opts.apiToken}`,
+              'Content-Type': 'application/json',
+            },
+            body: JSON.stringify({ sql, params }),
+            signal: AbortSignal.timeout(timeoutMs),
+          });
+        } catch (err) {
+          // A timed-out request may already have been applied, so only
+          // errors that happened before any response are retried.
+          if (!isTimeout(err) && attempt < maxRetries) {
+            await sleep(backoffMs(attempt, null));
+            continue;
+          }
+          throw err;
+        }
+
+        if (RETRYABLE_STATUS.has(res.status) && attempt < maxRetries) {
+          await sleep(backoffMs(attempt, res.headers.get('Retry-After')));
+          continue;
+        }
+
+        const body = (await res.json().catch(() => ({}))) as D1Envelope;
+        if (!res.ok || body.success === false) {
+          const errors = body.errors ?? [];
+          throw new D1ApiError(
+            errors.map((e) => e.message).join('; ') || `D1 request failed (${res.status})`,
+            res.status,
+            errors.map((e) => e.code),
+          );
+        }
+        const first = body.result?.[0];
+        return {
+          rows: (first?.results ?? []) as T[],
+          changes: first?.meta?.changes ?? 0,
+        };
+      }
+    },
+  };
+}
