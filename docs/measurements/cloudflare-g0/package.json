{
  "name": "cloudflare-g0-harness",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Throwaway Cloudflare Workers G0 measurement harness (not a Yarn workspace member; install with npm).",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "wrangler dev --local --port 8787",
    "check:canary": "node scripts/check-canary.mjs",
    "check:slice": "node scripts/check-slice.mjs",
    "check:probes": "node scripts/check-probes.mjs",
    "test": "node --test scripts/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/microservices": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^22.20.5",
    "wrangler": "^4.151.2"
  }
}
