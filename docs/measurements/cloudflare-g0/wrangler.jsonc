{
  "name": "icore-g0-harness",
  "main": "build/docs/measurements/cloudflare-g0/src/index.js",
  "tsconfig": "./tsconfig.bundle.json",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "PROBE", "class_name": "ProbeDurableObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProbeDurableObject"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "g0-probe",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "vars": {
    "SESSION_STORE": "memory",
    "G0_PROBE": "g0-env-ok",
    "G0_THROTTLE_LIMIT": "1000000",
    "NODE_ENV": "development",
  },
  "define": { "process.env.NODE_ENV": "\"development\"" },
  "alias": {
    "class-transformer/storage": "./node_modules/class-transformer/cjs/storage.js",
    "amqp-connection-manager": "./stubs/empty.js",
    "amqplib": "./stubs/empty.js",
    "@grpc/grpc-js": "./stubs/empty.js",
    "@grpc/proto-loader": "./stubs/empty.js",
    "ioredis": "./stubs/empty.js",
    "kafkajs": "./stubs/empty.js",
    "mqtt": "./stubs/empty.js",
    "nats": "./stubs/empty.js",
    "@nestjs/platform-socket.io": "./stubs/empty.js",
  },
}
